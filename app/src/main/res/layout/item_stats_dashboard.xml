<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
 android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="16dp">
 <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical">
  <com.google.android.material.button.MaterialButton android:id="@+id/period" style="?attr/materialButtonOutlinedStyle" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:minHeight="48dp" android:text="@string/lbl_all_time" />
  <com.google.android.material.button.MaterialButton android:id="@+id/history" style="?attr/borderlessButtonStyle" android:layout_width="wrap_content" android:layout_height="wrap_content" android:minHeight="48dp" android:text="@string/lbl_view_history" />
 </LinearLayout>
 <LinearLayout android:id="@+id/summary" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:paddingTop="12dp" android:paddingBottom="12dp">
  <TextView android:id="@+id/total_time" android:layout_width="match_parent" android:layout_height="wrap_content" android:textAppearance="?attr/textAppearanceHeadlineMedium" />
  <TextView android:id="@+id/total_plays" android:layout_width="match_parent" android:layout_height="wrap_content" android:textAppearance="?attr/textAppearanceTitleMedium" />
  <TextView android:id="@+id/average" android:layout_width="match_parent" android:layout_height="wrap_content" android:textAppearance="?attr/textAppearanceBodyMedium" android:textColor="?attr/colorOnSurfaceVariant" />
  <com.google.android.material.button.MaterialButton android:id="@+id/unavailable" style="?attr/borderlessButtonStyle" android:layout_width="match_parent" android:layout_height="wrap_content" android:minHeight="48dp" />
 </LinearLayout>
 <LinearLayout android:id="@+id/calendar_section" android:layout_marginStart="-8dp" android:layout_marginEnd="-8dp" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical">
  <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical">
   <com.google.android.material.button.MaterialButton android:id="@+id/previous_month" style="?attr/borderlessButtonStyle" android:layout_width="48dp" android:layout_height="48dp" android:insetLeft="0dp" android:insetRight="0dp" android:padding="0dp" android:text="@string/stats_previous_glyph" android:contentDescription="@string/stats_previous_month" />
   <TextView android:id="@+id/month" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:gravity="center" android:textAppearance="?attr/textAppearanceTitleMedium" />
   <com.google.android.material.button.MaterialButton android:id="@+id/next_month" style="?attr/borderlessButtonStyle" android:layout_width="48dp" android:layout_height="48dp" android:insetLeft="0dp" android:insetRight="0dp" android:padding="0dp" android:text="@string/stats_next_glyph" android:contentDescription="@string/stats_next_month" />
  </LinearLayout>
  <LinearLayout android:id="@+id/weekdays" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:importantForAccessibility="noHideDescendants" />
  <com.kizitonwose.calendar.view.CalendarView android:id="@+id/calendar" android:layout_width="match_parent" android:layout_height="wrap_content" app:cv_dayViewResource="@layout/item_calendar_day" app:cv_scrollPaged="true" app:cv_orientation="horizontal" />
 </LinearLayout>
 <com.google.android.material.button.MaterialButton android:id="@+id/category" style="?attr/materialButtonOutlinedStyle" android:layout_width="match_parent" android:layout_height="wrap_content" android:minHeight="48dp" android:text="@string/lbl_songs" />
 <com.google.android.material.materialswitch.MaterialSwitch android:id="@+id/by_plays" android:layout_width="match_parent" android:layout_height="wrap_content" android:minHeight="48dp" android:text="@string/stats_rank_by_plays" />
 <ProgressBar android:id="@+id/loading" android:layout_width="48dp" android:layout_height="48dp" android:layout_gravity="center_horizontal" android:contentDescription="@string/stats_loading" />
 <TextView android:id="@+id/status" android:layout_width="match_parent" android:layout_height="wrap_content" android:textAppearance="?attr/textAppearanceBodyMedium" android:accessibilityLiveRegion="polite" />
 <com.google.android.material.button.MaterialButton android:id="@+id/retry" style="?attr/borderlessButtonStyle" android:layout_width="match_parent" android:layout_height="wrap_content" android:minHeight="48dp" android:text="@string/stats_retry" />
</LinearLayout>
