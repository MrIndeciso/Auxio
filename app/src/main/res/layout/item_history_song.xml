<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
 android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="12dp" android:minHeight="80dp" android:background="?attr/selectableItemBackground" android:focusable="true">
 <TextView android:id="@+id/day_header" android:layout_width="match_parent" android:layout_height="wrap_content" android:paddingVertical="12dp" android:textAppearance="?attr/textAppearanceTitleSmall" />
 <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical">
  <org.oxycblt.auxio.image.CoverView android:id="@+id/history_cover" style="@style/Widget.Auxio.Image.Small" app:enablePlaybackIndicator="false" app:enableSelectionBadge="false" />
  <LinearLayout android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:layout_marginStart="12dp" android:orientation="vertical">
   <TextView android:id="@+id/song_name" android:layout_width="match_parent" android:layout_height="wrap_content" android:textAppearance="?attr/textAppearanceTitleMedium" />
   <TextView android:id="@+id/artist_name" android:layout_width="match_parent" android:layout_height="wrap_content" android:textAppearance="?attr/textAppearanceBodyMedium" android:textColor="?attr/colorOnSurfaceVariant" />
   <TextView android:id="@+id/timestamp" android:layout_width="match_parent" android:layout_height="wrap_content" android:textAppearance="?attr/textAppearanceBodyMedium" />
   <TextView android:id="@+id/duration" android:layout_width="match_parent" android:layout_height="wrap_content" android:textAppearance="?attr/textAppearanceBodyMedium" />
  </LinearLayout>
 </LinearLayout>
</LinearLayout>
